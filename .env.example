# AI Smart Cleaner - Environment Variables Configuration Template
# Copy this file to .env and provide your secret production values.

# Flask Core
FLASK_APP=run.py
FLASK_ENV=production
DEBUG=False
SECRET_KEY=change-to-a-very-secure-random-32-byte-hex-in-production

# Database Configuration (SQLite default; can point to PostgreSQL / MySQL)
DATABASE_URL=sqlite:///instance/smart_cleaner.db

# Cleaning SLA Target (Initial 12 Hours)
DEFAULT_DEADLINE_HOURS=12

# Civic Contact Info
CONTACT_EMAIL=support@aismartcleaner.org
CONTACT_PHONE=+1 (800) 555-0199
MUNICIPAL_HELPLINE=1916
